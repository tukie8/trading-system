# Zkopíruj do compose/.env a uprav. compose/.env je v .gitignore.

# Pevná verze Freqtrade image
FREQTRADE_VERSION=2026.9

# API klíče se sem přidají AŽ při přechodu na live (zatím nevyplňovat).
